@startuml
'https://plantuml.com/component-diagram

skinparam rectangle {
    roundCorner<<"">> 25
}



rectangle "French Road Accident Unified Decision Maker" <<FRAUD>>{
database "Input" {
file RoadAccidentData <<parquet>>
}

package "ZenML Machine Learning Module" {
[Data Loader] -- [Data Processor]
}

rectangle "CI/CD"
component "REST API"
component "DOCKER Containers"


package "Neptune AI"{
Collections "Severity Classifier Runs" <<version>>
Collections "Forecaster Runs" <<version>>
}



node "Other Groups" {
  FTP - [Second Component]
  [First Component] --> FTP
}

cloud "Comet ML"{
database "Road Accident Input Data"<<version>>{
}
Collections "Severity Classifier" <<version>>
Collections "Forecaster.pkl" <<version>>
}


database "MySql" {
  folder "This is my folder" {
    [Folder 3]
  }
  frame "Foo" {
    [Frame 4]
  }
}


[Another Component] --> [Example 1]
[Example 1] --> [Folder 3]
[Folder 3] --> [Frame 4]
}
@enduml